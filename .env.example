# Copy to .env and replace each placeholder with a local-only value.
# Existing PostgreSQL volumes retain their initialized password; changing this
# variable alone does not rotate credentials in an existing database.
POSTGRES_USER=runpulse
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
POSTGRES_DB=runpulse
DATABASE_URL=postgresql://runpulse:REPLACE_WITH_LOCAL_ONLY_PASSWORD@127.0.0.1:5433/runpulse?schema=public

# Test credentials are separate and only used by the isolated test service.
POSTGRES_TEST_USER=runpulse_test
POSTGRES_TEST_PASSWORD=REPLACE_WITH_DIFFERENT_TEST_PASSWORD
POSTGRES_TEST_DB=runpulse_test
RUNPULSE_TEST_DATABASE_URL=postgresql://runpulse_test:REPLACE_WITH_DIFFERENT_TEST_PASSWORD@127.0.0.1:5434/runpulse_test?schema=public

# Generate with: openssl rand -hex 32
ACTIVITY_FINGERPRINT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
