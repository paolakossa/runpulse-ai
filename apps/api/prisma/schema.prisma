generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id                               String   @id @default(uuid()) @db.Uuid
  fingerprint                      String   @unique(map: "activities_fingerprint_key") @db.VarChar(80)
  importedAt                       DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  startTime                        DateTime? @map("start_time") @db.Timestamptz(3)
  endTime                          DateTime? @map("end_time") @db.Timestamptz(3)
  segmentCount                     Int      @map("segment_count")
  trackPointCount                  Int      @map("track_point_count")
  totalDistanceMeters              Float?   @map("total_distance_meters")
  elapsedSeconds                   Float?   @map("elapsed_seconds")
  recordedDurationSeconds          Float?   @map("recorded_duration_seconds")
  averageElapsedPaceSecondsPerKm   Float?   @map("average_elapsed_pace_seconds_per_km")
  totalElevationGainMeters         Float?   @map("total_elevation_gain_meters")
  totalElevationLossMeters         Float?   @map("total_elevation_loss_meters")
  averageHeartRateBpm              Float?   @map("average_heart_rate_bpm")
  maxHeartRateBpm                  Float?   @map("max_heart_rate_bpm")
  hasOverlappingSegments           Boolean  @map("has_overlapping_segments")
  distanceCoverage                 Float?   @map("distance_coverage")
  elevationCoverage                Float?   @map("elevation_coverage")
  heartRateCoverage                Float?   @map("heart_rate_coverage")

  @@index([importedAt(sort: Desc), id(sort: Desc)], map: "activities_imported_at_id_idx")
  @@map("activities")
}
